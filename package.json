{
  "name": "@devaltitude/contentful-migrate",
  "version": "2.0.0",
  "description": "[AS] Migration tooling for Contentful, with state management",
  "keywords": [
    "migrate",
    "migrations",
    "contentful",
    "cms-as-code"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "ctf-migrate": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "test:ci": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushmm/contentful-migrate.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ushmm/contentful-migrate/issues"
  },
  "homepage": "https://github.com/ushmm/contentful-migrate#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.0.0",
    "neostandard": "^0.14.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "contentful-management": "^12.19.2",
    "contentful-migration": "^5.1.1",
    "listr2": "^9.0.5",
    "migrate": "^2.1.0",
    "yargs": "^17.7.2"
  }
}
